# Copy to .env (`flask run` and wsgi.py load it). All values here are demo values.

OPENAI_API_KEY=sk-demo-replace-me
OPENAI_MODEL=gpt-4o              # a vision-capable model your account can use
OPENAI_TIMEOUT=60
MAX_COMPLETION_TOKENS=700

MAX_UPLOAD_MB=10                 # largest photo accepted
RATE_LIMIT_PER_MINUTE=10         # per client address; 0 turns it off (each story costs an OpenAI call)
TRUSTED_PROXIES=0                # number of reverse proxies in front of the app (1 behind nginx)
LOG_LEVEL=INFO
